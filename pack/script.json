{"units":[{"id":"fa-alef","st":"abjad","set":1,"group":"alef","t":"ا","name":"alef","roman":"â","alt":["a","aa"],"say":"ا","note":"â as in 'father'; also carries a word-initial short vowel","confuse":["fa-alef-madde","fa-lam"],"ex":[["w0006","az"],["w0041","ammâ"],["w0586","arzân"]],"joins":"right","audio":"audio/x/fa-alef.8b0d96c6.opus"},{"id":"fa-be","st":"abjad","set":1,"group":"be","t":"ب","name":"be","roman":"b","say":"بَ","note":"b","confuse":["fa-pe","fa-te","fa-se","fa-nun"],"ex":[["w0014","bâ"],["w0065","bar"],["w0106","bordan"]],"joins":"dual","audio":"audio/x/fa-be.c6f633e7.opus"},{"id":"fa-pe","st":"abjad","set":1,"group":"be","t":"پ","name":"pe","roman":"p","say":"پَ","note":"p","confuse":["fa-be","fa-te","fa-se"],"ex":[["w0077","pedar"],["w0271","pâ"],["w0375","por"]],"joins":"dual","audio":"audio/x/fa-pe.bc654e5e.opus"},{"id":"fa-te","st":"abjad","set":1,"group":"be","t":"ت","name":"te","roman":"t","say":"تَ","note":"t","confuse":["fa-be","fa-pe","fa-se","fa-nun"],"ex":[["w0044","tâ"],["w0116","tamâm"],["w0244","moddat"]],"joins":"dual","audio":"audio/x/fa-te.0af76d06.opus"},{"id":"fa-dal","st":"abjad","set":1,"group":"dal","t":"د","name":"dâl","roman":"d","say":"دَ","note":"d","confuse":["fa-zal","fa-re"],"ex":[["w0008","dar"],["w0036","dâdan"],["w0327","dard"]],"joins":"right","audio":"audio/x/fa-dal.61229764.opus"},{"id":"fa-re","st":"abjad","set":1,"group":"re","t":"ر","name":"re","roman":"r","say":"رَ","note":"r","confuse":["fa-ze","fa-zhe","fa-dal"],"ex":[["w0007","râ"],["w0363","rad"],["w0008","dar"]],"joins":"right","audio":"audio/x/fa-re.33550dfc.opus"},{"id":"fa-ze","st":"abjad","set":1,"group":"re","t":"ز","name":"ze","roman":"z","say":"زَ","note":"z","confuse":["fa-re","fa-zhe","fa-zal"],"ex":[["w0052","zadan"],["w0080","zan"],["w0093","zamân"]],"joins":"right","audio":"audio/x/fa-ze.69fda893.opus"},{"id":"fa-mim","st":"abjad","set":1,"group":"mim","t":"م","name":"mim","roman":"m","say":"مَ","note":"m","confuse":["fa-he","fa-ghein"],"ex":[["w0009","man"],["w0017","mâ"],["w0086","mard"]],"joins":"dual","audio":"audio/x/fa-mim.71b81bbd.opus"},{"id":"fa-nun","st":"abjad","set":1,"group":"be","t":"ن","name":"nun","roman":"n","say":"نَ","note":"n","confuse":["fa-be","fa-te","fa-ye"],"ex":[["w0161","nâm"],["w0523","nân"],["w0009","man"]],"joins":"dual","audio":"audio/x/fa-nun.027a6440.opus"},{"id":"fa-se","st":"abjad","set":2,"group":"be","t":"ث","name":"se","roman":"s","say":"ثَ","note":"s (Arabic loanwords)","confuse":["fa-te","fa-be","fa-pe","fa-sin","fa-sad"],"ex":[["w0294","asar"]],"joins":"dual","audio":"audio/x/fa-se.6cc83a2e.opus"},{"id":"fa-jim","st":"abjad","set":2,"group":"jim","t":"ج","name":"jim","roman":"j","say":"جَ","note":"j","confuse":["fa-che","fa-he-jimi","fa-khe"],"ex":[["w0070","jâ"],["w0190","jân"],["w0367","panj"]],"joins":"dual","audio":"audio/x/fa-jim.a285fca8.opus"},{"id":"fa-che","st":"abjad","set":2,"group":"jim","t":"چ","name":"che","roman":"ch","say":"چَ","note":"ch","confuse":["fa-jim","fa-he-jimi","fa-khe"],"ex":[["w0051","cherâ"],["w0094","chand"]],"joins":"dual","audio":"audio/x/fa-che.7ab9abd0.opus"},{"id":"fa-he-jimi","st":"abjad","set":2,"group":"jim","t":"ح","name":"he-ye jimi","roman":"h","say":"حَ","note":"h (Arabic loanwords)","confuse":["fa-jim","fa-che","fa-khe","fa-he"],"ex":[["w0235","hatman"],["w0602","hadd"],["w0331","taht-e"]],"joins":"dual","audio":"audio/x/fa-he-jimi.6b7d4246.opus"},{"id":"fa-khe","st":"abjad","set":2,"group":"jim","t":"خ","name":"khe","roman":"kh","say":"خَ","note":"ch as in Scottish 'loch'","confuse":["fa-jim","fa-che","fa-he-jimi"],"ex":[["w0083","khodâ"],["w0141","khabar"],["w0156","khânom"]],"joins":"dual","audio":"audio/x/fa-khe.9411ed31.opus"},{"id":"fa-vav","st":"abjad","set":3,"group":"vav","t":"و","name":"vâv","roman":"v","alt":["u","o","ow"],"say":"و","note":"v; also the vowels u and o","confuse":["fa-dal","fa-re"],"ex":[["w0002","o"],["w0381","vey"],["w0001","budan"]],"joins":"right","audio":"audio/x/fa-vav.2c69a8a5.opus"},{"id":"fa-ye","st":"abjad","set":3,"group":"ye","t":"ی","name":"ye","roman":"y","alt":["i","ey"],"say":"ی","note":"y; also the vowel i","confuse":["fa-nun","fa-be"],"ex":[["w0033","yâ"],["w0398","yâd"],["w0565","yâzdah"]],"joins":"dual","audio":"audio/x/fa-ye.8b48d5cb.opus"},{"id":"fa-he","st":"abjad","set":3,"group":"he","t":"ه","name":"he","roman":"h","alt":["e"],"say":"هَ","note":"h; e at the end of a word","confuse":["fa-he-jimi","fa-mim"],"ex":[["w0025","ham"],["w0042","har"],["w0040","hame"]],"joins":"dual","audio":"audio/x/fa-he.23722166.opus"},{"id":"fa-alef-madde","st":"abjad","set":3,"group":"alef","t":"آ","name":"âlef-e madde","roman":"â","alt":["a","aa"],"say":"آ","note":"â at the start of a word","confuse":["fa-alef"],"ex":[["w0020","ân"],["w0024","âmadan"],["w0059","ânhâ"]],"joins":"right","audio":"audio/x/fa-alef-madde.98de0b3e.opus"},{"id":"fa-zal","st":"abjad","set":3,"group":"dal","t":"ذ","name":"zâl","roman":"z","say":"ذَ","note":"z (Arabic loanwords)","confuse":["fa-dal","fa-ze","fa-zad","fa-za"],"ex":[["w0596","âzar"]],"joins":"right","audio":"audio/x/fa-zal.911d15ca.opus"},{"id":"fa-zhe","st":"abjad","set":3,"group":"re","t":"ژ","name":"zhe","roman":"zh","say":"ژَ","note":"s as in 'pleasure'","confuse":["fa-ze","fa-re"],"ex":[["w0671","vizhe"],["w0830","enerzhi"],["w1014","porozhe"]],"joins":"right","audio":"audio/x/fa-zhe.7c9b09fa.opus"},{"id":"fa-sin","st":"abjad","set":4,"group":"sin","t":"س","name":"sin","roman":"s","say":"سَ","note":"s","confuse":["fa-shin","fa-sad","fa-se"],"ex":[["w0071","sar"],["w0149","sâkhtan"],["w0128","se"]],"joins":"dual","audio":"audio/x/fa-sin.998f5bee.opus"},{"id":"fa-shin","st":"abjad","set":4,"group":"sin","t":"ش","name":"shin","roman":"sh","say":"شَ","note":"sh","confuse":["fa-sin","fa-sad"],"ex":[["w0010","shodan"],["w0026","shomâ"],["w0124","shahr"]],"joins":"dual","audio":"audio/x/fa-shin.20b145d9.opus"},{"id":"fa-sad","st":"abjad","set":4,"group":"sad","t":"ص","name":"sâd","roman":"s","say":"صَ","note":"s (Arabic loanwords)","confuse":["fa-zad","fa-sin","fa-se"],"ex":[["w0169","surat"],["w0208","sadâ"],["w0233","sobh"]],"joins":"dual","audio":"audio/x/fa-sad.83ee6923.opus"},{"id":"fa-zad","st":"abjad","set":4,"group":"sad","t":"ض","name":"zâd","roman":"z","say":"ضَ","note":"z (Arabic loanwords)","confuse":["fa-sad","fa-ze","fa-zal","fa-za"],"ex":[["w0396","hâzer"],["w0550","mariz"]],"joins":"dual","audio":"audio/x/fa-zad.26b88921.opus"},{"id":"fa-ta","st":"abjad","set":4,"group":"ta","t":"ط","name":"tâ","roman":"t","say":"طَ","note":"t (Arabic loanwords)","confuse":["fa-za","fa-te"],"ex":[["w0293","towr"],["w0115","khâter"],["w0143","chetowr"]],"joins":"dual","audio":"audio/x/fa-ta.10eecd35.opus"},{"id":"fa-za","st":"abjad","set":4,"group":"ta","t":"ظ","name":"zâ","roman":"z","say":"ظَ","note":"z (Arabic loanwords)","confuse":["fa-ta","fa-ze","fa-zal","fa-zad"],"ex":[["w0533","zohr"],["w0122","nazar"],["w0226","manzur"]],"joins":"dual","audio":"audio/x/fa-za.ed0f1396.opus"},{"id":"fa-ein","st":"abjad","set":5,"group":"ein","t":"ع","name":"'eyn","roman":"'","say":"عَ","note":"a catch in the throat, often silent","confuse":["fa-ghein","fa-he-jimi"],"ex":[["w0176","onvân"],["w0221","eshq"],["w0270","aziz"]],"joins":"dual","audio":"audio/x/fa-ein.339becb3.opus"},{"id":"fa-ghein","st":"abjad","set":5,"group":"ein","t":"غ","name":"gheyn","roman":"gh","alt":["q"],"say":"غَ","note":"a throaty g, like French r","confuse":["fa-ein","fa-qaf"],"ex":[["w0386","ghazâ"],["w0608","gheyr-e"],["w0461","peyghâm"]],"joins":"dual","audio":"audio/x/fa-ghein.af87d6d7.opus"},{"id":"fa-fe","st":"abjad","set":5,"group":"fe","t":"ف","name":"fe","roman":"f","say":"فَ","note":"f","confuse":["fa-qaf","fa-ghein"],"ex":[["w0038","faqat"],["w0153","fard"],["w0168","fahmidan"]],"joins":"dual","audio":"audio/x/fa-fe.4eaa83a3.opus"},{"id":"fa-qaf","st":"abjad","set":5,"group":"fe","t":"ق","name":"qâf","roman":"q","alt":["gh"],"say":"قَ","note":"a throaty g (same sound as غ)","confuse":["fa-fe","fa-ghein"],"ex":[["w0230","qânun"],["w0291","qodrat"],["w0313","qesmat"]],"joins":"dual","audio":"audio/x/fa-qaf.6a48f3e3.opus"},{"id":"fa-kaf","st":"abjad","set":6,"group":"kaf","t":"ک","name":"kâf","roman":"k","say":"کَ","note":"k","confuse":["fa-gaf","fa-lam"],"ex":[["w0004","kardan"],["w0005","ke"],["w0032","kâr"]],"joins":"dual","audio":"audio/x/fa-kaf.e8d6cf1a.opus"},{"id":"fa-gaf","st":"abjad","set":6,"group":"kaf","t":"گ","name":"gâf","roman":"g","say":"گَ","note":"g as in 'go'","confuse":["fa-kaf"],"ex":[["w0018","goftan"],["w0048","gereftan"],["w0089","gozâshtan"]],"joins":"dual","audio":"audio/x/fa-gaf.b26dae92.opus"},{"id":"fa-lam","st":"abjad","set":6,"group":"lam","t":"ل","name":"lâm","roman":"l","say":"لَ","note":"l","confuse":["fa-alef","fa-kaf"],"ex":[["w0220","lotfan"],["w0227","lahze"],["w0250","lâzem"]],"joins":"dual","audio":"audio/x/fa-lam.029884c9.opus"}],"notes":[{"st":"abjad","set":1,"h":"Right to left, short vowels unwritten","body":"Persian is read from right to left. Only long vowels are letters: â (ا), u (و), i (ی). The short vowels a, e, o are not written, so بد can be bad."},{"st":"abjad","set":1,"h":"Joining","body":"Most letters join on both sides and change shape. Seven never join the letter after them: ا د ذ ر ز ژ و."},{"st":"abjad","set":3,"h":"Vowel letters","body":"و and ی are consonants (v, y) or long vowels (u, i). ه at the end of a word is often the vowel e (خانه khâne)."},{"st":"abjad","set":4,"h":"One sound, several letters","body":"Arabic loanwords keep their spelling: s is س ص ث, z is ز ذ ض ظ, t is ت ط. Learn which letter each word uses."},{"st":"abjad","set":5,"h":"Ezafe","body":"An unwritten -e links a noun to what describes it: ketâb-e man, my book. The pron shows it; the script does not."}]}
